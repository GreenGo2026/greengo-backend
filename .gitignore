# Uploads (ephemeral — use Cloudinary)
# Recursive: source images also land in assets/products/<batch>/ and images/,
# which the single-level patterns above missed.
assets/products/**/*.webp
assets/products/**/*.jpg
assets/products/**/*.png
assets/products/**/*.jpeg
assets/products/*.webp
assets/products/*.jpg
assets/products/*.png
assets/products/*.jpeg
images/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Diagnostic dumps
*.txt
diag_*.txt
replacements.txt

# Temporary scripts
find_steps.py
export_products.py

# Nested/stale frontend copies — the real frontend lives in its own repo
greengo-frontend/
src/

